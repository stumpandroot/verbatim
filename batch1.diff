diff --git a/link-transcriber/static/v10.css b/link-transcriber/static/v10.css
new file mode 100644
index 0000000..a6d273d
--- /dev/null
+++ b/link-transcriber/static/v10.css
@@ -0,0 +1,153 @@
+/* Verbatim v10: color as surface. Navy entry card, three-bar stage indicator, tinted view tags,
+   borderless tiles, 24-28 px radii, inline icon micro-animations. Loads last; overrides earlier layers. */
+
+:root{
+  --ink:#1E2340;--iris:#6C5CE7;--iris-deep:#5A4BD6;--coral:#FF8A6B;--lime:#B7E67E;--mist:#E8E7EE;
+  --iris-tint:#ECE9FF;--coral-tint:#FFE9E1;--lime-tint:#EEF7DC;--mist-tint:#F1F0F5;
+  --r-card:28px;--r-field:18px;--r-pill:999px;
+}
+
+/* ---- Inline icons: same sizing as the <img> they replace ---- */
+svg.vb-icon{display:inline-block;flex:none;vertical-align:middle;width:1em;height:1em}
+.nav-icon.brand-icon,.mobile-link svg.vb-icon{width:24px;height:24px}
+.ui-icon{width:19px;height:19px}.button-arrow{width:15px;height:15px;margin-left:5px}
+.tiny-arrow,.tiny-note-icon{width:14px;height:14px}.micro-symbol{width:17px;height:17px}
+.feature-symbol svg.vb-icon,.info-tile .feature-symbol svg.vb-icon{width:30px;height:30px}
+.empty-note-illustration{width:64px;height:64px;padding:16px;box-sizing:border-box}
+.search-field-icon,.url-chain.url-icon{width:22px;height:22px}
+.ai-icon{width:30px;height:30px}.save-action-icon{width:17px;height:17px}.file-link .ui-icon{width:20px;height:20px}
+.primary-btn svg.button-arrow,.primary-btn svg.ui-icon,#libraryNew svg.ui-icon,#refineButton svg.ui-icon{stroke:#fff}
+.primary-btn svg.button-arrow path,.primary-btn svg.ui-icon path,#libraryNew svg.ui-icon path,#refineButton svg.ui-icon path{stroke:#fff}
+#refineButton.is-ready svg.ui-icon path{stroke:currentColor}
+.primary-btn .button-arrow,.mobile-plus .ui-icon,#libraryNew .ui-icon,#refineButton .ui-icon{filter:none}
+
+/* ---- Micro-animations (tap feedback only; nothing moves while reading) ---- */
+@keyframes vb-pop{0%{transform:scale(1)}40%{transform:scale(1.14)}70%{transform:scale(.96)}100%{transform:scale(1)}}
+.vb-pop{animation:vb-pop .26s cubic-bezier(.2,.9,.24,1)}
+.mobile-link svg.vb-icon path:last-child,.nav-link svg.vb-icon path:last-child{transition:stroke-dashoffset .3s ease,opacity .3s ease}
+.mobile-link:not(.selected) svg.vb-icon path:last-child,.nav-link:not(.selected) svg.vb-icon path:last-child{opacity:.45}
+#saveButton svg.vb-icon{transition:transform .2s cubic-bezier(.2,.9,.24,1)}
+#copyButton.vb-pop svg.vb-icon{animation:vb-pop .26s}
+@media(prefers-reduced-motion:reduce){.vb-pop{animation:none}}
+
+/* ---- Global surfaces: no hairlines, no shadows, bigger radii ---- */
+.input-surface,.result-main,.library-card,.info-tile,.detail-card,.export-card,.process-card,.platform-dialog,.empty-note,.review-item,.summary-header{border:0;box-shadow:none}
+.result-main,.library-card,.info-tile,.detail-card,.export-card,.process-card{border-radius:var(--r-card)}
+.result-main{background:#fff}
+.workspace-nav{border-bottom:0;padding:16px 16px 0}
+.info-tile{background:var(--mist-tint)}.info-tile:nth-child(2){background:var(--iris-tint)}.info-tile:nth-child(3){background:var(--lime-tint)}
+.detail-card{background:var(--mist-tint)}.export-card{background:var(--iris-tint)}
+.library-card{background:#fff}
+.library-image{background:var(--iris-tint);border-radius:18px}
+.library-card:nth-child(3n+2) .library-image{background:var(--coral-tint)}.library-card:nth-child(3n) .library-image{background:var(--lime-tint)}
+.library-open{background:var(--ink);color:#fff}.library-remove{background:var(--coral-tint)}
+.topbar{border-bottom:0;background:transparent}
+.sidebar{border-right:0;background:transparent}
+.icon-button{border:0;background:var(--mist-tint)}
+.outline-btn{border:0;background:var(--mist-tint)}
+.primary-btn{box-shadow:none;border-radius:var(--r-pill)}
+.primary-btn:hover:not(:disabled){box-shadow:none;transform:none}
+.mobile-nav{border-top:0;box-shadow:none;background:#faf8f2f0}
+.toast{border-radius:var(--r-pill)}
+.search-row{border:0;background:var(--mist-tint);border-radius:var(--r-field)}
+.transcript-segment{border-bottom:0}
+.ai-bottom{border-top:0;background:var(--mist-tint);border-radius:0 0 var(--r-card) var(--r-card)}
+.review-item{background:var(--coral-tint)}
+.summary-header{background:var(--lime-tint);border-radius:20px}
+
+/* ---- Home: the navy entry card is the hero ---- */
+.hero-grid{min-height:0;margin-bottom:0}
+#page-home .signature-stage{background:none}
+.input-surface.hero-card{background:var(--ink);color:#fff;border-radius:var(--r-card);padding:22px 20px 18px;display:flex;flex-direction:column;gap:12px;margin:0}
+.hero-card .hero-copy{display:block}
+.hero-card h1{color:#fff;margin:0;font-size:clamp(28px,7.6vw,36px);line-height:1.05;letter-spacing:-.045em;max-width:100%}
+.hero-card .text-gradient{background:none;-webkit-background-clip:initial;background-clip:initial;color:var(--lime)}
+.hero-card .hero-description{color:#fff;opacity:.9;margin:0;font-size:14px;line-height:1.45;max-width:100%}
+#page-home .hero-card .hero-description{color:#fff}
+.url-row{display:flex;flex-direction:column;gap:10px;border:0;padding:0;margin:0;min-height:0;background:transparent}
+#page-home .url-row{display:flex;grid-template-columns:none;padding:0;row-gap:10px}
+.url-field{display:flex;align-items:center;gap:10px;background:#fff;border-radius:var(--r-field);padding:0 14px;min-height:52px;color:var(--ink)}
+.url-field input{flex:1;min-width:0;border:0;outline:0;background:transparent;font-size:16px;color:var(--ink);min-height:48px;padding:0;width:auto}
+.url-field input::placeholder{color:#6F6E84}
+.url-field:focus-within{box-shadow:0 0 0 3px var(--lime) inset}
+#page-home .url-row input{min-height:48px;grid-column:auto;grid-row:auto;padding:0}
+#page-home .url-chain.url-icon{grid-column:auto;grid-row:auto;justify-self:auto}
+.url-actions{display:flex;gap:8px}
+#page-home .url-row .paste-btn,.paste-btn{grid-column:auto;grid-row:auto;background:#ffffff22;color:#fff;border:0;border-radius:var(--r-pill);min-height:46px;width:auto;padding:0 20px;font-size:15px;font-weight:800}
+#page-home .url-row .primary-btn,.url-row .primary-btn{grid-column:auto;grid-row:auto;flex:1;background:var(--lime);color:var(--ink);min-height:46px;border-radius:var(--r-pill);font-size:15px;font-weight:800;padding:0 16px;margin:0}
+.url-row .primary-btn:hover:not(:disabled){background:#c6ec92}
+.url-row .primary-btn svg.button-arrow path,.url-row .primary-btn svg.button-arrow{stroke:var(--ink)}
+.url-row .primary-btn .button-arrow{filter:none}
+.hero-card .form-error{color:#FFD9CF;font-size:13px;margin:0}
+.hero-card .platform-detect{color:#fff;opacity:.85;font-size:13px;margin:0}
+.hero-card .platform-detect.is-recognized{color:var(--lime);opacity:1}
+.hero-card .platform-detect.is-recognized:before{filter:brightness(0) saturate(100%) invert(93%) sepia(14%) saturate(900%) hue-rotate(40deg)}
+.input-foot.under-card{margin:12px 2px 0;display:flex;align-items:center;justify-content:space-between;gap:10px}
+#page-home .input-foot.under-card{margin-top:12px}
+.platform-pill{color:var(--muted)}
+.input-actions select{border:0;background:var(--mist-tint);border-radius:var(--r-field);color:var(--ink)}
+.file-entry{margin-top:6px}
+#page-home .home-section-head{padding-top:4px}
+@media (max-width:660px){
+  #page-home .signature-stage{height:92px;min-height:92px;margin:0 auto 2px}
+  #page-home .signature-illustration{transform:scale(.42)}
+  #page-home .input-surface.hero-card{padding:18px 16px 14px;gap:10px}
+  .hero-card h1{font-size:clamp(26px,7.4vw,32px);margin:0}
+  #page-home .hero-card .hero-description{font-size:13.5px;line-height:1.4}
+  #page-home .input-foot.under-card{margin-top:10px}
+}
+@media (max-width:660px) and (max-height:760px){
+  #page-home .signature-stage{height:70px;min-height:70px}
+  #page-home .signature-illustration{transform:scale(.32)}
+  #page-home .hero-card .hero-description{display:block;font-size:13px}
+  .file-entry{margin-top:2px}
+}
+@media (max-width:660px) and (max-height:625px){
+  #page-home .signature-stage{display:none}
+  #page-home .hero-card .hero-description{display:none}
+}
+
+/* ---- Processing: the three logo bars fill by stage ---- */
+.process-card{background:#fff;padding-top:28px}
+.stage-bars{display:flex;align-items:flex-end;justify-content:center;gap:16px;height:190px;margin:26px 0 8px}
+.stage-bar{display:block;width:48px;height:100%;border-radius:var(--r-pill);background:var(--mist-tint);position:relative;overflow:hidden}
+.stage-bar:nth-child(2){height:78%}.stage-bar:nth-child(3){height:56%}
+.stage-bar i{position:absolute;left:0;right:0;bottom:0;height:0;border-radius:var(--r-pill);transition:height .7s cubic-bezier(.2,.9,.24,1)}
+.stage-bar:nth-child(1) i{background:var(--iris)}.stage-bar:nth-child(2) i{background:var(--coral)}.stage-bar:nth-child(3) i{background:var(--lime)}
+/* current stage breathes between 55% and 85%; finished stages are full */
+@keyframes vb-stage-breathe{0%,100%{height:58%}50%{height:86%}}
+.stage-bars[data-stage="0"] .stage-bar:nth-child(1) i{animation:vb-stage-breathe 2.2s ease-in-out infinite}
+.stage-bars[data-stage="1"] .stage-bar:nth-child(1) i{height:100%}
+.stage-bars[data-stage="1"] .stage-bar:nth-child(2) i{animation:vb-stage-breathe 2.2s ease-in-out infinite}
+.stage-bars[data-stage="2"] .stage-bar:nth-child(1) i,.stage-bars[data-stage="2"] .stage-bar:nth-child(2) i{height:100%}
+.stage-bars[data-stage="2"] .stage-bar:nth-child(3) i{animation:vb-stage-breathe 2.2s ease-in-out infinite}
+.stage-bars[data-stage="3"] .stage-bar i{height:100%;animation:none}
+@media(prefers-reduced-motion:reduce){.stage-bar i{animation:none!important;transition:none}
+  .stage-bars[data-stage="0"] .stage-bar:nth-child(1) i,.stage-bars[data-stage="1"] .stage-bar:nth-child(2) i,.stage-bars[data-stage="2"] .stage-bar:nth-child(3) i{height:70%}}
+.step-list{grid-template-columns:repeat(3,1fr);gap:10px;margin-top:6px;text-align:center}
+.step-item{justify-content:center;font-size:12px;letter-spacing:.3px;text-transform:uppercase;font-weight:800;color:var(--text-label)}
+.step-marker{display:none}
+.process-progress-meta{justify-content:center;margin:10px 0 4px}
+.progress-bar{display:none}
+.process-title{font-size:clamp(30px,8vw,40px)}
+@media (max-width:660px){.stage-bars{height:150px;gap:14px}.stage-bar{width:42px}.step-list{grid-template-columns:repeat(3,1fr)}.step-item{font-size:11px}}
+
+/* ---- Transcript: views as tinted tags ---- */
+.tab-scroller{gap:8px;padding-bottom:12px;overflow:auto}
+.workspace-tab{padding:0 14px;min-height:40px;border-radius:var(--r-pill);background:var(--mist-tint);color:var(--ink);font-size:13.5px;font-weight:800}
+.workspace-tab.selected:after{display:none}
+.workspace-tab.selected{color:var(--ink)}
+.workspace-tab[data-tab="original"].selected{background:var(--iris);color:#fff}
+.workspace-tab[data-tab="cleaned"].selected{background:var(--coral);color:var(--ink)}
+.workspace-tab[data-tab="summary"].selected{background:var(--lime);color:var(--ink)}
+.workspace-tab[data-tab="review"].selected{background:var(--ink);color:#fff}
+.result-source-pill{background:var(--lime-tint);color:#3f5a1e}
+.timecode{background:var(--iris-tint);color:var(--iris-deep)}
+.summary-time{background:var(--lime-tint);color:#3f5a1e}
+.summary-num{background:var(--lime);color:var(--ink)}
+.empty-note-illustration{background:var(--iris-tint)}
+
+/* ---- Library and About ---- */
+.generic-heading h1{font-size:clamp(34px,9vw,44px)}
+#libraryNew{background:var(--ink)}
+.settings-tools .outline-btn{background:var(--coral-tint);color:#8a3a24}
diff --git a/link-transcriber/static/v9.css b/link-transcriber/static/v9.css
new file mode 100644
index 0000000..c7c634a
--- /dev/null
+++ b/link-transcriber/static/v9.css
@@ -0,0 +1,177 @@
+/* Verbatim v9.1 (Batch 1): readable type, AA contrast, 44 px targets, safe-area and keyboard fixes.
+   Overrides earlier layers on purpose; collapsing the five files into one is a separate task. */
+
+:root{
+  /* Two secondary-text tokens, both >= 4.9:1 on every surface the app uses (paper, white, lilac, lime, peach). */
+  --text-muted:#5F5F74;
+  --text-label:#62617A;
+}
+
+/* Visually hidden, still read by VoiceOver. */
+.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
+
+/* ---- Contrast: replace the failing gray tier everywhere ---- */
+.hero-description,.process-copy,.process-notice,.state-explain,.trust-disclaimer,.settings-caveat,.info-tile p,
+.result-meta,.library-card p,.ai-bottom p,.export-card p,.platform-dialog p,.empty-note,.empty-note p,
+.review-item p,.summary-header p,.generic-heading p,.rail-bottom,.detail-row span,.feature-card>span:nth-last-child(2),
+.step-item,.platform-detect,.tiny-note{color:var(--text-muted)}
+#page-home .hero-description{color:var(--text-muted)}
+.rail-label,.section-kicker,.eyebrow,.input-kicker,.tiny-stamp,.field-label,.detail-kicker,.source-preview-header,
+.crumb,.page-footer,.feature-end,.muted-label,.feature-number,.visual-caption,.search-count{color:var(--text-label)}
+.workspace-tab{color:var(--text-label)}
+.workspace-tab.selected{color:var(--violet-dark)}
+.mobile-link{color:var(--text-label)}
+.ghost-button,.back-link{color:var(--text-muted)}
+.url-row input::placeholder,.search-row input::placeholder{color:#6F6E84}
+.nav-count{color:var(--text-muted)}
+.library-remove{color:#a9452f}
+.review-item strong{color:#a9452f}
+.summary-num{color:#9b5842}
+.result-source-pill{color:#4f6b2a}
+.step-marker{color:var(--text-label)}
+
+/* ---- Type floor: nothing under 12 px on a phone; body copy 13-15 px ---- */
+@media (max-width:660px){
+  #page-home .hero-copy h1{margin:6px 0 8px}
+  #page-home .hero-description{font-size:14px;line-height:1.5;max-width:360px}
+  #page-home .url-row input{font-size:16px;min-height:34px}
+  #page-home .url-row .paste-btn{font-size:14px}
+  #page-home .url-row .primary-btn{font-size:15px}
+  #page-home .platform-detect{font-size:13px;margin-top:8px}
+  #page-home .form-error{font-size:13px}
+  #page-home .input-foot{align-items:center}
+  #page-home #showPlatforms{font-size:13px;min-height:44px;padding:0 6px}
+  /* 16 px stops Safari from zooming the whole page when the control is focused. */
+  #page-home .input-actions select,.input-actions select{font-size:16px;min-height:44px;padding:6px 10px;max-width:160px}
+  #page-home .home-section-head{padding-top:12px}
+  #page-home .home-section-head h2{font-size:17px}
+  #page-home .home-section-head .text-action{font-size:14px;min-height:44px}
+  .search-row input{font-size:16px}
+  .workspace-tab{font-size:14px}
+  .mobile-link{font-size:12px}
+  .process-notice,.process-copy{font-size:14px}
+  .step-item{font-size:13px}
+  .trust-disclaimer,.result-meta,.detail-row,.detail-row strong,.export-buttons button,.library-card p,.settings-caveat,.ai-bottom p{font-size:13px}
+  .result-source-pill{font-size:11px}
+  .state-explain,.review-item,.summary-item-content{font-size:14px}
+  .form-error{font-size:13px}
+  .toast{font-size:14px}
+}
+/* The compact breakpoints in v7 shrank these further; hold the floor there too. */
+@media (max-width:660px) and (max-height:760px){
+  #page-home .hero-description{font-size:13.5px;line-height:1.45;display:block}
+  #page-home .home-section-head h2{font-size:16px}
+}
+@media (max-width:660px) and (max-height:625px){
+  #page-home .hero-description{display:none}
+}
+
+/* ---- Home hierarchy: one headline, one form, one sample link ---- */
+.input-top,.tiny-stamp,.input-kicker{display:none}
+.input-surface{padding-top:18px}
+#page-home .field-label{display:none}
+@media (max-width:660px){
+  #page-home .input-surface{padding:14px 14px 12px}
+  /* "What you get" has nothing under it unless the shortcut cards are shown; hide the heading, keep Try a sample. */
+  #page-home .home-section-head h2{display:none}
+  #page-home .home-section-head{justify-content:flex-end}
+}
+@media (min-height:790px) and (max-width:660px){
+  #page-home .home-section-head h2{display:block}
+  #page-home .home-section-head{justify-content:space-between}
+}
+/* The + button duplicates Home while you are on Home. */
+body.vb-topnew-hidden #topNew{display:none}
+@media (min-width:861px){ body.vb-topnew-hidden #topNew{display:none} }
+
+/* ---- Fit, not clip: if content ever outgrows the screen (Larger Text, long error), let it scroll ---- */
+@media (max-width:660px){
+  body:has(#page-home.active) #mainContent{overflow-y:auto;-webkit-overflow-scrolling:touch}
+  #page-home.active{overflow:visible}
+}
+
+/* ---- Tap targets: 44 px on every interactive element ---- */
+.icon-button,.top-new,#closePlatforms{width:44px;height:44px}
+@media (max-width:660px){.topbar-right .top-new{width:44px;height:44px}}
+.transcript-segment{grid-template-columns:58px 1fr;align-items:center}
+.timecode{min-height:44px;min-width:56px;display:inline-flex;align-items:center;justify-content:center;font-size:12px}
+.summary-time{min-height:44px;min-width:56px;display:inline-flex;align-items:center;justify-content:center;font-size:12px}
+.library-open,.library-remove{min-height:44px}
+.all-platforms,.quiet-link,.text-action{min-height:44px;display:inline-flex;align-items:center}
+.ghost-button,.back-link{min-height:44px}
+.export-buttons button{min-height:44px;font-size:12px}
+.workspace-tab{min-height:48px}
+
+/* ---- Processing: stage bar without a fake percentage ---- */
+.process-progress-meta{font-size:14px}
+.process-progress-meta strong{display:none}
+
+/* Keyboard: v7 already lets the home scroll while the URL field is focused. Do not shift layout on focus or blur:
+   the Get transcript button must not move under the finger as the keyboard closes. */
+
+/* ---- Focus and selection stay visible on the new colors ---- */
+.mobile-link:focus-visible,.nav-link:focus-visible{outline:3px solid #917dff;outline-offset:2px}
+
+/* ---- Follow-ups from the viewport check ---- */
+@media (max-width:860px){
+  .mobile-link[data-view="home"],.mobile-link[data-view="library"],.mobile-link[data-view="settings"]{font-size:12px}
+}
+@media (max-width:660px){
+  #page-home .url-row input{min-height:44px}
+  #page-home .url-row{row-gap:4px}
+  /* Decorative rotated stamps were 7-8 px; they carry no information. */
+  #page-home .stage-top-note,#page-home .stage-stamp{display:none}
+}
+@media (min-height:790px) and (max-width:660px){
+  #page-home .feature-card .mobile-feature-label{font-size:12px}
+}
+@media (max-width:660px){
+  #page-home .input-actions{min-width:0;flex:0 1 auto}
+  #page-home .input-actions select,.input-actions select{max-width:min(160px,40vw)}
+  #page-home .home-section-head{justify-content:center}
+}
+@media (min-height:790px) and (max-width:660px){ #page-home .home-section-head{justify-content:space-between} }
+@media (max-width:660px){
+  #page-home .platform-row{flex:0 0 auto}
+  #page-home .input-actions{flex:1 1 90px;min-width:84px;max-width:160px;margin-left:auto}
+  #page-home .input-actions select,.input-actions select{width:100%;max-width:none;min-width:0;padding:6px 26px 6px 8px}
+}
+.summary-time,.timecode{color:#4F3FC2}
+.demo-badge{color:#7a5417;font-size:11px}
+.library-head h2 span{color:#4F3FC2}
+.visual-caption span{color:#b4482c}
+
+/* Export preview dialog (offline preview only) */
+.export-dialog textarea{width:100%;min-height:220px;font:13px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--ink);background:#f8f7fb;border:1px solid #e9e7ed;border-radius:12px;padding:12px;margin:0 0 14px;resize:vertical;box-sizing:border-box}
+
+/* ---- One icon family: 2 px stroke SVGs. Raster icons retired. ---- */
+.nav-icon.brand-icon,.mobile-link img{width:24px;height:24px;opacity:1}
+.mobile-link img{opacity:.85}.mobile-link.selected img{opacity:1}
+.feature-symbol img,.info-tile .feature-symbol img{width:30px;height:30px}
+.empty-note-illustration{width:64px;height:64px;padding:16px}
+.search-field-icon,.url-chain.url-icon{width:22px;height:22px}
+.ai-icon{width:30px;height:30px}
+.processing-mark img{width:56px;height:56px}
+.play-disc img{width:30px;height:30px}
+.library-image{background-size:46%}
+/* Sound-to-text illustration as one SVG; bars breathe, lines settle. */
+.signature-illustration{width:330px;height:165px;display:block;filter:drop-shadow(0 10px 15px #5d46c81a)}
+.sig-bar{transform-box:fill-box;transform-origin:center;animation:vb-sig-breathe 2.8s ease-in-out infinite}
+.sig-bar:nth-child(2){animation-delay:.17s}.sig-bar:nth-child(3){animation-delay:.34s}.sig-bar:nth-child(4){animation-delay:.51s}.sig-bar:nth-child(5){animation-delay:.68s}
+@keyframes vb-sig-breathe{0%,100%{transform:scaleY(1)}30%{transform:scaleY(1.12)}60%{transform:scaleY(.9)}}
+.sig-line{transform-box:fill-box;transform-origin:left center;animation:vb-sig-line 3.5s ease-in-out infinite}
+.sig-line:nth-child(2){animation-delay:.25s}.sig-line:nth-child(3){animation-delay:.5s}
+@keyframes vb-sig-line{50%{transform:scaleX(.8)}}
+@media(prefers-reduced-motion:reduce){.sig-bar,.sig-line{animation:none!important}}
+
+/* ---- File entry: second way in, quiet, 44 px ---- */
+.file-entry{margin-top:8px}
+.file-link{font-size:14px;min-height:44px;gap:8px;padding:0 2px;color:var(--violet-dark)}
+.file-link .ui-icon{width:20px;height:20px}
+#fileNote{margin-top:2px}
+@media (max-width:660px){
+  .file-entry{margin-top:4px}
+  .file-link{font-size:13px;min-height:40px}
+  #page-home .home-section-head{padding-top:6px}
+}
+@media (max-width:660px) and (max-height:625px){ .file-link{min-height:36px} }
