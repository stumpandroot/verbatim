diff --git a/link-transcriber/static/v9.css b/link-transcriber/static/v9.css
new file mode 100644
index 0000000..eacdcee
--- /dev/null
+++ b/link-transcriber/static/v9.css
@@ -0,0 +1,142 @@
+/* Verbatim v9.1 (Batch 1): readable type, AA contrast, 44 px targets, safe-area and keyboard fixes.
+   Overrides earlier layers on purpose; collapsing the five files into one is a separate task. */
+
+:root{
+  /* Two secondary-text tokens, both >= 4.9:1 on every surface the app uses (paper, white, lilac, lime, peach). */
+  --text-muted:#5F5F74;
+  --text-label:#62617A;
+}
+
+/* Visually hidden, still read by VoiceOver. */
+.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
+
+/* ---- Contrast: replace the failing gray tier everywhere ---- */
+.hero-description,.process-copy,.process-notice,.state-explain,.trust-disclaimer,.settings-caveat,.info-tile p,
+.result-meta,.library-card p,.ai-bottom p,.export-card p,.platform-dialog p,.empty-note,.empty-note p,
+.review-item p,.summary-header p,.generic-heading p,.rail-bottom,.detail-row span,.feature-card>span:nth-last-child(2),
+.step-item,.platform-detect,.tiny-note{color:var(--text-muted)}
+#page-home .hero-description{color:var(--text-muted)}
+.rail-label,.section-kicker,.eyebrow,.input-kicker,.tiny-stamp,.field-label,.detail-kicker,.source-preview-header,
+.crumb,.page-footer,.feature-end,.muted-label,.feature-number,.visual-caption,.search-count{color:var(--text-label)}
+.workspace-tab{color:var(--text-label)}
+.workspace-tab.selected{color:var(--violet-dark)}
+.mobile-link{color:var(--text-label)}
+.ghost-button,.back-link{color:var(--text-muted)}
+.url-row input::placeholder,.search-row input::placeholder{color:#6F6E84}
+.nav-count{color:var(--text-muted)}
+.library-remove{color:#a9452f}
+.review-item strong{color:#a9452f}
+.summary-num{color:#9b5842}
+.result-source-pill{color:#4f6b2a}
+.step-marker{color:var(--text-label)}
+
+/* ---- Type floor: nothing under 12 px on a phone; body copy 13-15 px ---- */
+@media (max-width:660px){
+  #page-home .hero-copy h1{margin:6px 0 8px}
+  #page-home .hero-description{font-size:14px;line-height:1.5;max-width:360px}
+  #page-home .url-row input{font-size:16px;min-height:34px}
+  #page-home .url-row .paste-btn{font-size:14px}
+  #page-home .url-row .primary-btn{font-size:15px}
+  #page-home .platform-detect{font-size:13px;margin-top:8px}
+  #page-home .form-error{font-size:13px}
+  #page-home .input-foot{align-items:center}
+  #page-home #showPlatforms{font-size:13px;min-height:44px;padding:0 6px}
+  /* 16 px stops Safari from zooming the whole page when the control is focused. */
+  #page-home .input-actions select,.input-actions select{font-size:16px;min-height:44px;padding:6px 10px;max-width:160px}
+  #page-home .home-section-head{padding-top:12px}
+  #page-home .home-section-head h2{font-size:17px}
+  #page-home .home-section-head .text-action{font-size:14px;min-height:44px}
+  .search-row input{font-size:16px}
+  .workspace-tab{font-size:14px}
+  .mobile-link{font-size:12px}
+  .process-notice,.process-copy{font-size:14px}
+  .step-item{font-size:13px}
+  .trust-disclaimer,.result-meta,.detail-row,.detail-row strong,.export-buttons button,.library-card p,.settings-caveat,.ai-bottom p{font-size:13px}
+  .result-source-pill{font-size:11px}
+  .state-explain,.review-item,.summary-item-content{font-size:14px}
+  .form-error{font-size:13px}
+  .toast{font-size:14px}
+}
+/* The compact breakpoints in v7 shrank these further; hold the floor there too. */
+@media (max-width:660px) and (max-height:760px){
+  #page-home .hero-description{font-size:13.5px;line-height:1.45;display:block}
+  #page-home .home-section-head h2{font-size:16px}
+}
+@media (max-width:660px) and (max-height:625px){
+  #page-home .hero-description{display:none}
+}
+
+/* ---- Home hierarchy: one headline, one form, one sample link ---- */
+.input-top,.tiny-stamp,.input-kicker{display:none}
+.input-surface{padding-top:18px}
+#page-home .field-label{display:none}
+@media (max-width:660px){
+  #page-home .input-surface{padding:14px 14px 12px}
+  /* "What you get" has nothing under it unless the shortcut cards are shown; hide the heading, keep Try a sample. */
+  #page-home .home-section-head h2{display:none}
+  #page-home .home-section-head{justify-content:flex-end}
+}
+@media (min-height:790px) and (max-width:660px){
+  #page-home .home-section-head h2{display:block}
+  #page-home .home-section-head{justify-content:space-between}
+}
+/* The + button duplicates Home while you are on Home. */
+body.vb-topnew-hidden #topNew{display:none}
+@media (min-width:861px){ body.vb-topnew-hidden #topNew{display:none} }
+
+/* ---- Fit, not clip: if content ever outgrows the screen (Larger Text, long error), let it scroll ---- */
+@media (max-width:660px){
+  body:has(#page-home.active) #mainContent{overflow-y:auto;-webkit-overflow-scrolling:touch}
+  #page-home.active{overflow:visible}
+}
+
+/* ---- Tap targets: 44 px on every interactive element ---- */
+.icon-button,.top-new,#closePlatforms{width:44px;height:44px}
+@media (max-width:660px){.topbar-right .top-new{width:44px;height:44px}}
+.transcript-segment{grid-template-columns:58px 1fr;align-items:center}
+.timecode{min-height:44px;min-width:56px;display:inline-flex;align-items:center;justify-content:center;font-size:12px}
+.summary-time{min-height:44px;min-width:56px;display:inline-flex;align-items:center;justify-content:center;font-size:12px}
+.library-open,.library-remove{min-height:44px}
+.all-platforms,.quiet-link,.text-action{min-height:44px;display:inline-flex;align-items:center}
+.ghost-button,.back-link{min-height:44px}
+.export-buttons button{min-height:44px;font-size:12px}
+.workspace-tab{min-height:48px}
+
+/* ---- Processing: stage bar without a fake percentage ---- */
+.process-progress-meta{font-size:14px}
+.process-progress-meta strong{display:none}
+
+/* Keyboard: v7 already lets the home scroll while the URL field is focused. Do not shift layout on focus or blur:
+   the Get transcript button must not move under the finger as the keyboard closes. */
+
+/* ---- Focus and selection stay visible on the new colors ---- */
